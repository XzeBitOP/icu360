# Copy to .env.local for local development. Never commit real values.

# View counter (Upstash Redis, REST API). Leave empty and counting is simply switched off.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for the private /stats page (exact view counts).
STATS_PASSWORD=

# Public URL, used for metadata and share links. Defaults to https://icu360.in
NEXT_PUBLIC_SITE_URL=https://icu360.in
