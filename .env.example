# Copy to .env.local for local development. Never commit real values.

# View counter (Upstash Redis, REST API). Leave empty and counting is simply switched off.
# Either naming works. UPSTASH_* wins if both are set. The Vercel Marketplace "Upstash for Redis"
# integration adds KV_REST_API_URL / KV_REST_API_TOKEN automatically (use `vercel env pull`).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Password for the private /stats page (exact view counts).
STATS_PASSWORD=

# Public URL, used for metadata and share links. Defaults to https://icu360.in
NEXT_PUBLIC_SITE_URL=https://icu360.in

# Google Search Console HTML-tag verification (optional). Paste the token only, not the full meta tag.
GOOGLE_SITE_VERIFICATION=
